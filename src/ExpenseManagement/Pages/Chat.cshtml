@page
@model ChatModel
@{
    ViewData["Title"] = "AI Chat";
}

<div class="header">
    <div class="container">
        <h1>Expense Management AI Assistant</h1>
    </div>
</div>

<div class="container">
    <div class="card">
        <h2>💬 Chat with AI</h2>
        <p>Ask me anything about your expenses! I can help you view, create, and manage expenses using natural language.</p>
        
        <div id="chat-container" style="background: var(--light-gray); border-radius: 8px; padding: 20px; min-height: 400px; max-height: 600px; overflow-y: auto; margin-bottom: 20px;">
            <div id="messages"></div>
        </div>
        
        <div style="display: flex; gap: 10px;">
            <input type="text" id="user-input" class="form-control" placeholder="Type your message here..." onkeypress="if(event.key==='Enter') sendMessage()" />
            <button onclick="sendMessage()" class="btn btn-primary" id="send-btn">Send</button>
        </div>
        
        <div class="button-group mt-20">
            <a href="/Index" class="btn btn-danger">Back to Home</a>
        </div>
    </div>
    
    <div class="card">
        <h3>Example Questions:</h3>
        <ul>
            <li>"Show me all my expenses"</li>
            <li>"What expenses are pending approval?"</li>
            <li>"Create an expense for £50 for travel today"</li>
            <li>"List all expense categories"</li>
            <li>"Show me expenses from last week"</li>
        </ul>
    </div>
</div>

<script>
    const conversationHistory = [];
    
    async function sendMessage() {
        const input = document.getElementById('user-input');
        const message = input.value.trim();
        
        if (!message) return;
        
        // Disable input while processing
        input.disabled = true;
        document.getElementById('send-btn').disabled = true;
        
        // Add user message to chat
        addMessage('user', message);
        conversationHistory.push(message);
        input.value = '';
        
        // Add loading indicator
        const loadingId = 'loading-' + Date.now();
        addMessage('assistant', '...', loadingId);
        
        try {
            // Send to server
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    message: message,
                    history: conversationHistory
                })
            });
            
            const data = await response.json();
            
            // Remove loading indicator
            const loadingElement = document.getElementById(loadingId);
            if (loadingElement) {
                loadingElement.remove();
            }
            
            // Add AI response
            addMessage('assistant', data.response);
            conversationHistory.push(data.response);
        } catch (error) {
            console.error('Error:', error);
            const loadingElement = document.getElementById(loadingId);
            if (loadingElement) {
                loadingElement.remove();
            }
            addMessage('assistant', 'Sorry, I encountered an error. Please try again.');
        }
        
        // Re-enable input
        input.disabled = false;
        document.getElementById('send-btn').disabled = false;
        input.focus();
    }
    
    function addMessage(role, text, id) {
        const messagesDiv = document.getElementById('messages');
        const messageDiv = document.createElement('div');
        if (id) messageDiv.id = id;
        
        messageDiv.style.cssText = `
            margin-bottom: 15px;
            padding: 12px 15px;
            border-radius: 8px;
            ${role === 'user' 
                ? 'background: var(--primary-color); color: white; margin-left: 20%; text-align: right;' 
                : 'background: white; margin-right: 20%; border: 1px solid var(--medium-gray);'}
        `;
        
        const formattedText = formatMessage(text);
        messageDiv.innerHTML = formattedText;
        
        messagesDiv.appendChild(messageDiv);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }
    
    function formatMessage(text) {
        // Escape HTML to prevent XSS
        let escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        
        // Apply markdown-style formatting after escaping
        // Bold text
        escaped = escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        
        // Numbered lists
        escaped = escaped.replace(/^\d+\.\s+(.+)$/gm, '<li>$1</li>');
        if (escaped.includes('<li>')) {
            escaped = escaped.replace(/(<li>.*<\/li>)/s, '<ol>$1</ol>');
        }
        
        // Bullet lists
        escaped = escaped.replace(/^[-*]\s+(.+)$/gm, '<li>$1</li>');
        if (escaped.includes('<li>') && !escaped.includes('<ol>')) {
            escaped = escaped.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');
        }
        
        // Line breaks
        escaped = escaped.replace(/\n/g, '<br>');
        
        return escaped;
    }
    
    // Initial greeting
    window.addEventListener('load', () => {
        addMessage('assistant', 'Hello! I\'m your Expense Management AI Assistant. How can I help you today?');
    });
</script>
